# Optional: set this instead of using application-local.properties
# Spring Boot maps SUPABASE_DB_PASSWORD to spring.datasource.password when configured.

SUPABASE_DB_PASSWORD=YOUR_PASSWORD
SPRING_MAIL_USERNAME=your@gmail.com
SPRING_MAIL_PASSWORD=your-gmail-app-password
JWT_SECRET=change-this-to-a-random-secret-at-least-32-characters-long
