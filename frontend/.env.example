# Example environment variables for API base URL, WebSocket endpoint, and other frontend runtime config.
# Copy this to .env.local and fill in actual values for your environment.

# Backend API base URL (e.g., http://localhost:8081, https://api.example.com)
VITE_API_BASE_URL=http://localhost:8081

# Optional: WebSocket URL for real-time chat/notifications
VITE_WS_URL=ws://localhost:8081/ws

# App environment (development, staging, production)
VITE_APP_ENV=development
